[
 {
  "start": 0.0,
  "end": 0.98,
  "text": "Представь…"
 },
 {
  "start": 1.64,
  "end": 4.24,
  "text": "Ты проснулся, а цивилизация рухнула."
 },
 {
  "start": 4.8,
  "end": 9.06,
  "text": "Связи нет. Магазины закрыты. На улицах паника."
 },
 {
  "start": 9.51,
  "end": 13.54,
  "text": "У тебя есть семьдесят два часа, чтобы подготовиться к тому, что будет дальше."
 },
 {
  "start": 13.88,
  "end": 16.4,
  "text": "И первая ошибка может стать последней."
 },
 {
  "start": 17.01,
  "end": 18.09,
  "text": "Правило номер один."
 },
 {
  "start": 18.45,
  "end": 20.21,
  "text": "Забудь о бесполезных вещах."
 },
 {
  "start": 20.59,
  "end": 25.07,
  "text": "Тебе нужны вода, консервы, аптечка, фонарь и запасные батарейки."
 },
 {
  "start": 25.43,
  "end": 27.9,
  "text": "Заряди телефон. Скачай офлайн-карты."
 },
 {
  "start": 28.23,
  "end": 28.89,
  "text": "И запомни…"
 },
 {
  "start": 29.17,
  "end": 33.23,
  "text": "Вода важнее большинства вещей, которые ты привык считать необходимыми."
 },
 {
  "start": 33.7,
  "end": 34.59,
  "text": "Но есть проблема."
 },
 {
  "start": 35.04,
  "end": 36.96,
  "text": "Ты не знаешь, кому можно доверять."
 },
 {
  "start": 37.5,
  "end": 38.2,
  "text": "Стук в дверь."
 },
 {
  "start": 38.64,
  "end": 40.63,
  "text": "«Эй! Открой! У меня раненый друг!»"
 },
 {
  "start": 40.63,
  "end": 41.62,
  "text": "Ты замираешь."
 },
 {
  "start": 42.18,
  "end": 42.89,
  "text": "Три удара."
 },
 {
  "start": 43.56,
  "end": 44.16,
  "text": "Пауза."
 },
 {
  "start": 44.78,
  "end": 47.98,
  "text": "И вдруг голос за дверью становится тише."
 },
 {
  "start": 48.45,
  "end": 49.64,
  "text": "«Я знаю, что ты там…»"
 },
 {
  "start": 50.37,
  "end": 51.44,
  "text": "Правило номер два."
 },
 {
  "start": 51.77,
  "end": 52.88,
  "text": "Не теряй голову."
 },
 {
  "start": 53.19,
  "end": 55.59,
  "text": "Не открывай дверь незнакомцам автоматически."
 },
 {
  "start": 55.83,
  "end": 57.6,
  "text": "Сначала оцени ситуацию."
 },
 {
  "start": 57.86,
  "end": 59.71,
  "text": "Не подвергай себя ненужному риску."
 },
 {
  "start": 60.32,
  "end": 62.58,
  "text": "Наступает вторая ночь."
 },
 {
  "start": 62.92,
  "end": 65.97,
  "text": "Ты сидишь в темноте и слушаешь радио."
 },
 {
  "start": 66.3,
  "end": 68.15,
  "text": "Сквозь помехи пробивается голос."
 },
 {
  "start": 68.58,
  "end": 72.22,
  "text": "«Всем выжившим… повторяем… не покидайте укрытия…»"
 },
 {
  "start": 72.74,
  "end": 73.73,
  "text": "Сигнал пропадает."
 },
 {
  "start": 74.11,
  "end": 75.3,
  "text": "Ты настраиваешь радио."
 },
 {
  "start": 75.6,
  "end": 76.94,
  "text": "И слышишь другой голос."
 },
 {
  "start": 77.32,
  "end": 81.54,
  "text": "«Если вы слышите это сообщение… не доверяйте предыдущей передаче»."
 },
 {
  "start": 82.17,
  "end": 83.25,
  "text": "Правило номер три."
 },
 {
  "start": 83.57,
  "end": 84.94,
  "text": "Проверяй информацию."
 },
 {
  "start": 85.33,
  "end": 90.05,
  "text": "В мире, где нет связи и порядка, слухи могут быть опаснее самой катастрофы."
 },
 {
  "start": 90.57,
  "end": 92.64,
  "text": "Ты выключаешь радио."
 },
 {
  "start": 92.86,
  "end": 94.48,
  "text": "Внезапно телефон вибрирует."
 },
 {
  "start": 94.8,
  "end": 97.1,
  "text": "На экране сообщение с неизвестного номера."
 },
 {
  "start": 97.49,
  "end": 98.77,
  "text": "«НЕ СМОТРИ В ОКНО»."
 },
 {
  "start": 99.3,
  "end": 101.03,
  "text": "Ты медленно поднимаешь глаза."
 },
 {
  "start": 101.44,
  "end": 102.59,
  "text": "На улице никого нет."
 },
 {
  "start": 102.97,
  "end": 105.5,
  "text": "Но за твоей спиной раздаётся скрип пола."
 },
 {
  "start": 105.74,
  "end": 109.32,
  "text": "И знаешь, что самое страшное в апокалипсисе?"
 },
 {
  "start": 109.68,
  "end": 113.34,
  "text": "Ты никогда не узнаешь, когда перестанешь быть тем, кто выживает…"
 },
 {
  "start": 113.63,
  "end": 116.35,
  "text": "И станешь тем, от кого выживают остальные."
 }
]