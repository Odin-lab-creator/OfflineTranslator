<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.15"
        android:text="VALHALLA"
        android:textColor="@color/valhalla_gold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.4"
        android:text="TRANSLATE"
        android:textColor="@color/valhalla_muted"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_gold"
            android:gravity="center"
            android:maxLines="1"
            android:text="Текст"
            android:textColor="@color/valhalla_bg"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_screenshot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_outline"
            android:gravity="center"
            android:maxLines="1"
            android:text="Скриншот"
            android:textColor="@color/valhalla_gold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_camera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_outline"
            android:gravity="center"
            android:maxLines="1"
            android:text="Камера"
            android:textColor="@color/valhalla_gold"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
